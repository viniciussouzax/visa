# ============================================================
# DS-160 Worker — Cloud Run Job
# Image: Playwright + Node.js for headless form filling
# ============================================================
FROM mcr.microsoft.com/playwright:v1.50.0-noble

WORKDIR /app

# Install dependencies first (cache layer)
COPY package.json package-lock.json* ./
RUN npm ci --production --ignore-scripts

# Install Playwright browsers (Firefox only — less detectable by anti-bot)
RUN npx playwright install firefox --with-deps

# Copy application code
COPY automation/ ./automation/
COPY pages/ ./pages/

# Create tmp directory for captcha screenshots
RUN mkdir -p /app/tmp

# Environment
ENV HEADLESS=true
ENV NODE_ENV=production

# Entrypoint: process 1 applicant, then exit
CMD ["node", "automation/ds160-entry.js"]
