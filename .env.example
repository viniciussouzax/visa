# ===========================================================
# SENDS160 — Variáveis de Ambiente
# ===========================================================
# Copie este arquivo para .env e preencha com seus valores
# ===========================================================

# Supabase — obrigatórios
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=eyJ...sua_anon_key_aqui

# Worker auth — para RLS funcionar no queue runner
WORKER_EMAIL=worker@suaempresa.com
WORKER_PASSWORD="sua_senha_segura"

# Execução
HEADLESS=false

# Organização — filtra fila por empresa
COMPANY_ID=seu-uuid-aqui

# Proxy — formato: http://user:pass@host:port (opcional)
# Se configurado, o filler usará proxy para acessar CEAC
# PROXY_URL=http://user:password@proxy.dataimpulse.com:8000
