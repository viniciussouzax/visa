{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
    "productName": "SENDS160",
    "version": "1.5.0",
    "identifier": "com.sends160.app",
    "build": {
        "beforeBuildCommand": "node scripts/copy-resources.js",
        "frontendDist": "../renderer"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "SENDS160",
                "width": 420,
                "height": 520,
                "resizable": false,
                "maximizable": false,
                "center": true,
                "decorations": true
            }
        ],
        "security": {
            "csp": null
        },
        "trayIcon": {
            "id": "main-tray",
            "iconPath": "icons/32x32.png",
            "tooltip": "SENDS160 — Automação DS-160"
        }
    },
    "bundle": {
        "active": true,
        "resources": [
            "resources/"
        ],
        "targets": [
            "nsis",
            "dmg",
            "deb",
            "appimage"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": "v1Compatible",
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3NDIwMjhCRENEOUFDQ0YKUldUUHJObmNpd0pDVjMwdzdzL09UVjNvbDhUMXdMdWthOEYzVzI2TkRFb2ZOZjQyUlpGOGc1T1gK",
            "endpoints": [
                "https://github.com/viniciussouzax/visa/releases/latest/download/latest.json"
            ]
        }
    }
}
