{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
    "productName": "SENDS160",
    "version": "1.2.0",
    "identifier": "com.sends160.app",
    "build": {
        "frontendDist": "../renderer"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "SENDS160",
                "width": 420,
                "height": 520,
                "resizable": false,
                "center": true,
                "decorations": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    },
    "plugins": {}
}