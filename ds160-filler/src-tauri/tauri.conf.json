{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
    "productName": "DS-160 Filler",
    "version": "1.2.0",
    "identifier": "com.ds160.filler",
    "build": {
        "frontendDist": "../renderer",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "",
        "beforeBuildCommand": ""
    },
    "app": {
        "windows": [
            {
                "title": "SENDS160",
                "width": 420,
                "height": 520,
                "resizable": false,
                "center": true,
                "decorations": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    },
    "plugins": {
        "shell": {
            "open": true,
            "scope": {
                "node-sidecar": {
                    "name": "node",
                    "cmd": "node",
                    "args": true
                }
            }
        }
    }
}