{
    "name": "ds160-filler",
    "version": "1.0.0",
    "description": "DS-160 Auto-Filler - Software de automação",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win --publish never",
        "release": "electron-builder --win --publish always",
        "install-browsers": "npx playwright install chromium"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.45.0",
        "electron-updater": "^6.8.3",
        "playwright": "^1.49.0"
    },
    "devDependencies": {
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0"
    },
    "build": {
        "appId": "com.ds160.filler",
        "productName": "DS-160 Filler",
        "publish": {
            "provider": "github",
            "owner": "viniciussouzax",
            "repo": "visa"
        },
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": true,
            "allowToChangeInstallationDirectory": false,
            "installerIcon": null,
            "uninstallerIcon": null,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "files": [
            "main.js",
            "preload.js",
            "renderer/**",
            "automation/**",
            "node_modules/**"
        ]
    }
}
