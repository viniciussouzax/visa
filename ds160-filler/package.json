{
    "name": "ds160-filler",
    "version": "1.0.0",
    "description": "DS-160 Auto-Filler - Software de automação",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win portable",
        "install-browsers": "npx playwright install chromium"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.45.0",
        "playwright": "^1.49.0"
    },
    "devDependencies": {
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0"
    },
    "build": {
        "appId": "com.ds160.filler",
        "productName": "DS-160 Filler",
        "win": {
            "target": "portable"
        },
        "files": [
            "main.js",
            "preload.js",
            "renderer/**",
            "automation/**",
            "node_modules/**"
        ]
    }
}